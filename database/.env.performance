# ============================================================
# ENV PERFORMANCE CONFIGURATION
# ============================================================
# Copy these values to your .env file for production
# ============================================================

# ── APP ──
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# ── CACHE (Use Redis for high concurrency) ──
CACHE_STORE=redis
CACHE_PREFIX=bprs-cache-
CACHE_DRIVER=redis

# ── SESSION (Use Redis for concurrent sessions) ──
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_STORE=redis

# ── QUEUE (Use Redis for faster job processing) ──
QUEUE_CONNECTION=redis

# ── REDIS ──
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=bprs-database-

# ── RESPONSE CACHE ──
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_DRIVER=redis
RESPONSE_CACHE_LIFETIME=604800

# ── DATABASE ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bprs_cms
DB_USERNAME=root
DB_PASSWORD=your_secure_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── PHP OPcache (set in php.ini or opcache.ini) ──
# opcache.enable=1
# opcache.memory_consumption=128
# opcache.interned_strings_buffer=16
# opcache.max_accelerated_files=10000
# opcache.revalidate_freq=2
